classDiagram
    class Owner {
        -name: str
        -daily_time_budget_minutes: int
        +add_pet(pet: Pet): void
        +update_time_budget(minutes: int): void
    }

    class Pet {
        -name: str
        -species: str
        -age: int
        -health_flags: list[str]
        +add_health_flag(flag: str): void
        +get_profile(): dict
    }

    class Task {
        <<Abstract>>
        -task_id: str
        -title: str
        -duration_minutes: int
        -base_priority: int
        -is_completed: bool
        +mark_complete(): void
        +calculate_urgency(): float
    }

    class SchedulerEngine {
        +generate_plan(owner: Owner, pet: Pet, tasks: list[Task]) list[Task]
        +sort_tasks(tasks: list[Task]) list[Task]
    }

    Owner "1" o-- "0..*" Pet : manages
    Pet "1" *-- "0..*" Task : owns
    SchedulerEngine ..> Owner : evaluates
    SchedulerEngine ..> Pet : evaluates
    SchedulerEngine ..> Task : prioritizes
